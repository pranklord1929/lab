# ─── LLM ───────────────────────────────────────────────────────
# Fournisseur : "anthropic" (Claude) ou "deepseek"
LLM_PROVIDER=anthropic

# Clé Anthropic (si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Clé DeepSeek (si LLM_PROVIDER=deepseek)
# DEEPSEEK_API_KEY=sk-...

# Modèle Claude à utiliser (optionnel, défaut : claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── GITHUB ────────────────────────────────────────────────────
# Token GitHub avec droit d'écriture sur le repo (scope: repo)
# Créer sur : https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...

# Propriétaire du repo (ton pseudo GitHub)
GITHUB_OWNER=jean-dupont

# Nom du repo
GITHUB_REPO=mon-site

# Branche cible (défaut : main)
GITHUB_BRANCH=main

# ─── SITE ──────────────────────────────────────────────────────
# Nom de ton site / marque
SITE_NAME=Mon Super Site

# URL publique du site (sans slash final)
SITE_URL=https://mon-site.netlify.app

# Description courte : niche, activité, cible — nourrit les prompts SEO
SITE_DESCRIPTION=Blog sur la photographie de voyage et les techniques de prise de vue en lumière naturelle

# Ton de voix des articles (ex : "expert mais accessible", "direct et humour")
SITE_TONE=expert mais chaleureux, sans jargon inutile

# ─── BLOG ──────────────────────────────────────────────────────
# Dossier des articles HTML dans le repo (défaut : blog)
BLOG_DIR=blog

# Chemin vers l'index du blog (défaut : blog/index.html)
BLOG_INDEX_PATH=blog/index.html

# Balise HTML APRÈS laquelle insérer la nouvelle carte d'article dans l'index
# Exemple : '<div class="post-list">' ou '<ul id="articles">'
BLOG_INDEX_ANCHOR=<div class="post-list">

# Chemin du sitemap.xml (laisser vide pour désactiver)
SITEMAP_PATH=sitemap.xml
